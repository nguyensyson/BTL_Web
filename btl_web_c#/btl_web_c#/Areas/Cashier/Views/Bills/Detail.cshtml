@using RestaurantOrdering.Models.Entities
@model Bill
@{
    ViewData["Title"] = $"Chi tiết hóa đơn {Model.BillNo}";
    var settings = ViewBag.Settings as Dictionary<string, string> ?? new();
    var restaurantName = settings.GetValueOrDefault("RestaurantName", "Nhà hàng");
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a href="@Url.Action("History")" class="btn btn-outline-secondary btn-sm me-2">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
        <h4 class="fw-bold mb-0 d-inline-block">Hóa đơn @Model.BillNo</h4>
    </div>
    <a href="@Url.Action("Print", new { cartId = Model.CartId })" target="_blank"
       class="btn btn-outline-primary btn-sm">
        <i class="bi bi-printer me-1"></i>In lại
    </a>
</div>

<div class="row g-4">
    <!-- Thông tin chung -->
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header fw-semibold">Thông tin hóa đơn</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Mã hóa đơn</dt>
                    <dd class="col-7"><code class="fw-bold text-primary">@Model.BillNo</code></dd>

                    <dt class="col-5">Bàn</dt>
                    <dd class="col-7">@Model.TableNames</dd>

                    <dt class="col-5">Phục vụ</dt>
                    <dd class="col-7">@(Model.Cart?.Waiter?.FullName ?? "—")</dd>

                    <dt class="col-5">Thu ngân</dt>
                    <dd class="col-7">@(Model.Cashier?.FullName ?? "—")</dd>

                    <dt class="col-5">Tạo lúc</dt>
                    <dd class="col-7">@Model.CreatedTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-5">Thanh toán lúc</dt>
                    <dd class="col-7">@(Model.PaidTime?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa")</dd>

                    <dt class="col-5">Trạng thái</dt>
                    <dd class="col-7">
                        @{
                            var (badgeCss, statusText) = Model.Status switch
                            {
                                0 => ("warning", "Chưa thanh toán"),
                                1 => ("success", "Đã thanh toán"),
                                2 => ("danger", "Đã hủy"),
                                _ => ("secondary", "?")
                            };
                        }
                        <span class="badge bg-@badgeCss">@statusText</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Chi tiết số tiền -->
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">Chi tiết món</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Món</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.BillDetails.OrderBy(x => x.Id))
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@d.ProductName</div>
                                    @if (!string.IsNullOrEmpty(d.OptionsText))
                                    {
                                        <small class="text-muted">@d.OptionsText</small>
                                    }
                                </td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end">@d.UnitPrice.ToString("N0") ₫</td>
                                <td class="text-end">@d.LineTotal.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end">Tạm tính</td>
                            <td class="text-end">@Model.SubTotal.ToString("N0") ₫</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">Phí dịch vụ</td>
                            <td class="text-end">@Model.ServiceFee.ToString("N0") ₫</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end">Thuế VAT</td>
                            <td class="text-end">@Model.TaxAmount.ToString("N0") ₫</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr class="text-success">
                                <td colspan="3" class="text-end">Giảm giá</td>
                                <td class="text-end">-@Model.DiscountAmount.ToString("N0") ₫</td>
                            </tr>
                        }
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end fs-6">Tổng cộng</td>
                            <td class="text-end fs-6 text-primary">@Model.TotalAmount.ToString("N0") ₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Thanh toán -->
            @if (Model.Payments.Any())
            {
                <div class="card-footer">
                    <p class="fw-semibold mb-2 small">Lịch sử thanh toán</p>
                    @foreach (var p in Model.Payments.OrderBy(x => x.PaidTime))
                    {
                        <div class="d-flex justify-content-between small">
                            <span>@p.PaymentMethod.Name @(p.ReferenceNo != null ? $"(Ref: {p.ReferenceNo})" : "")</span>
                            <span class="fw-semibold">@p.Amount.ToString("N0") ₫</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
