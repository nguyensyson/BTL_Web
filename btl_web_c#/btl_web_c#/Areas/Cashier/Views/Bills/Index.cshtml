@using RestaurantOrdering.ViewModels.Cashier
@model List<BillListItemVm>
@{
    ViewData["Title"] = "Danh sách bill";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-receipt me-2"></i>Danh sách bill chờ thanh toán</h5>
    <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> Làm mới
    </button>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 empty-state">
        <i class="bi bi-check-circle" style="font-size:4rem;color:#2ECC71"></i>
        <h5 class="mt-3">Không có bill chờ thanh toán</h5>
        <p class="text-muted">Tất cả bàn đã được thanh toán hoặc chưa có yêu cầu.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@item.TableNames</span>
                        <span class="badge @(item.BillStatus == 1 ? "bg-success" : "bg-danger")">
                            @(item.BillStatus == 1 ? "Đã TT" : "Chưa TT")
                        </span>
                    </div>
                    <div class="card-body py-2">
                        <div class="small text-muted mb-1">
                            <i class="bi bi-geo-alt me-1"></i>@item.AreaName
                            <span class="ms-2"><i class="bi bi-people me-1"></i>@item.GuestCount khách</span>
                        </div>
                        <div class="small text-muted mb-1">
                            <i class="bi bi-clock me-1"></i>@item.OpenedTime.ToLocalTime().ToString("HH:mm")
                            <span class="ms-2 text-warning">@item.UnpaidMinutes phút</span>
                        </div>
                        <div class="small text-muted mb-1">
                            <i class="bi bi-person me-1"></i>NV: @item.WaiterName
                        </div>
                        <div class="mt-2">
                            <span class="text-muted small">Tạm tính:</span>
                            <span class="fw-bold text-primary float-end">@item.SubTotal.ToString("N0") ₫</span>
                        </div>
                        @if (item.PaidAmount > 0)
                        {
                            <div>
                                <span class="text-muted small">Đã trả:</span>
                                <span class="fw-bold text-success float-end">@item.PaidAmount.ToString("N0") ₫</span>
                            </div>
                            <div>
                                <span class="text-muted small">Còn lại:</span>
                                <span class="fw-bold text-danger float-end">@item.RemainingAmount.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white py-2">
                        @if (item.BillStatus == 1)
                        {
                            <a asp-action="Print" asp-route-cartId="@item.CartId"
                               class="btn btn-sm btn-outline-secondary w-100" target="_blank">
                                <i class="bi bi-printer me-1"></i>In hóa đơn
                            </a>
                        }
                        else
                        {
                            <a asp-action="Pay" asp-route-cartId="@item.CartId"
                               class="btn btn-sm btn-primary w-100">
                                <i class="bi bi-credit-card me-1"></i>Thanh toán
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
