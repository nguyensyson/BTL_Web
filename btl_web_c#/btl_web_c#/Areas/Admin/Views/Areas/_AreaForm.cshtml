@model RestaurantOrdering.ViewModels.Admin.AreaViewModel
<form id="area-form" asp-area="Admin" asp-controller="Areas" asp-action="Save" method="post" onsubmit="return submitForm(this)">
    <div class="modal-header">
        <h5 class="modal-title fw-semibold">@(Model.Id==0?"Thêm khu vực":"Sửa khu vực")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id"/>
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-medium"></label>
            <input asp-for="Name" class="form-control" autofocus/>
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SortOrder" class="form-label fw-medium"></label>
            <input asp-for="SortOrder" class="form-control" type="number" min="0"/>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    </div>
    <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button>
    </div>
</form>
