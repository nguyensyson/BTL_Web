@{
    ViewData["Title"] = "Khu vực";
    ViewData["Breadcrumb"] = "Khu vực";
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-geo-alt me-2 text-primary"></i>Khu vực</h4>
    <button class="btn btn-primary" onclick="openForm(0)"><i class="bi bi-plus-lg me-1"></i>Thêm khu vực</button>
</div>
<form method="get" class="mb-3">
    <div class="input-group" style="max-width:380px">
        <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm khu vực..." />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(ViewBag.Q as string)) { <a href="/Admin/Areas" class="btn btn-outline-danger"><i class="bi bi-x"></i></a> }
    </div>
</form>
@if (Model is IEnumerable<dynamic> items && items.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>#</th><th>Tên khu vực</th><th class="text-center">Thứ tự</th><th class="text-center">Số bàn</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                    @{ int idx = (page-1)*10; }
                    @foreach (var item in items) {
                        idx++;
                        <tr>
                            <td class="text-muted small">@idx</td>
                            <td class="fw-medium">@item.Name</td>
                            <td class="text-center">@item.SortOrder</td>
                            <td class="text-center"><span class="badge bg-secondary">@item.TableCount</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="openForm(@item.Id)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteItem(@item.Id,'@item.Name')"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">Tổng: @ViewBag.Total mục</small>
        @if (totalPages > 1) {
            <nav><ul class="pagination pagination-sm mb-0">
                @for(int i=Math.Max(1,page-2);i<=Math.Min(totalPages,page+2);i++) {
                    <li class="page-item @(i==page?"active":"")"><a class="page-link" href="?q=@ViewBag.Q&page=@i">@i</a></li>
                }
            </ul></nav>
        }
    </div>
}
else { <div class="empty-state"><i class="bi bi-geo-alt fs-1 text-secondary"></i><h5 class="mt-3 text-secondary">Chưa có khu vực nào</h5></div> }

<div class="modal fade" id="form-modal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" id="form-modal-content"></div></div></div>
@section Scripts {
<script>
    const _af = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    function openForm(id) {
        fetch(`/Admin/Areas/Form?id=${id}`,{headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(r=>r.text()).then(html=>{
            document.getElementById('form-modal-content').innerHTML=html;
            new bootstrap.Modal(document.getElementById('form-modal')).show();
            $.validator.unobtrusive.parse('#area-form');
        });
    }
    function submitForm(form){
        const fd=new FormData(form);
        fetch(form.action,{method:'POST',body:fd}).then(r=>r.json()).then(data=>{
            if(data.success){bootstrap.Modal.getInstance(document.getElementById('form-modal'))?.hide();showToast(data.message,'success');setTimeout(()=>location.reload(),800);}
        });
        return false;
    }
    function deleteItem(id,name){
        confirmAction(`Xóa khu vực "${name}"?`,()=>{
            const fd=new FormData();fd.append('id',id);fd.append('__RequestVerificationToken',_af);
            fetch('/Admin/Areas/Delete',{method:'POST',body:fd}).then(r=>r.json()).then(data=>{
                showToast(data.message,data.success?'success':'danger');
                if(data.success)setTimeout(()=>location.reload(),800);
            });
        });
    }
</script>
}
