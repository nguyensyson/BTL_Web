@model RestaurantOrdering.ViewModels.Admin.ResetPasswordViewModel
<form asp-area="Admin" asp-controller="Staff" asp-action="ResetPassword" method="post" onsubmit="return submitPwd(this)">
    <div class="modal-header">
        <h5 class="modal-title fw-semibold">Đặt lại mật khẩu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="UserId"/>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-medium"></label>
            <input asp-for="NewPassword" type="password" class="form-control" autofocus/>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    </div>
    <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-warning"><i class="bi bi-key me-1"></i>Đặt lại</button>
    </div>
</form>
