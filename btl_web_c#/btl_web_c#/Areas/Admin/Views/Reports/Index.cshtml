@{
    ViewData["Title"] = "Báo cáo";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-graph-up me-2 text-primary"></i>Báo cáo</h4>
</div>

<div class="row g-4">
    <div class="col-sm-6 col-lg-3">
        <a href="@Url.Action("Revenue")" class="text-decoration-none">
            <div class="card card-body text-center py-4 h-100 hover-shadow">
                <div class="fs-1 text-success mb-2"><i class="bi bi-currency-dollar"></i></div>
                <div class="fw-semibold">Doanh thu</div>
                <div class="text-muted small mt-1">Doanh thu theo ngày, tuần, tháng</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="@Url.Action("TopProducts")" class="text-decoration-none">
            <div class="card card-body text-center py-4 h-100 hover-shadow">
                <div class="fs-1 text-primary mb-2"><i class="bi bi-bar-chart-fill"></i></div>
                <div class="fw-semibold">Món bán chạy</div>
                <div class="text-muted small mt-1">Top món theo số lượng và doanh thu</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="@Url.Action("PeakHours")" class="text-decoration-none">
            <div class="card card-body text-center py-4 h-100 hover-shadow">
                <div class="fs-1 text-warning mb-2"><i class="bi bi-clock"></i></div>
                <div class="fw-semibold">Giờ cao điểm</div>
                <div class="text-muted small mt-1">Phân phối khách theo giờ trong ngày</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-lg-3">
        <a href="@Url.Action("Kitchen")" class="text-decoration-none">
            <div class="card card-body text-center py-4 h-100 hover-shadow">
                <div class="fs-1 text-danger mb-2"><i class="bi bi-fire"></i></div>
                <div class="fw-semibold">Hiệu suất bếp</div>
                <div class="text-muted small mt-1">Thời gian chế biến trung bình</div>
            </div>
        </a>
    </div>
</div>

@section Styles {
<style>
.hover-shadow:hover { box-shadow: 0 4px 16px rgba(0,0,0,.1); transform: translateY(-2px); transition: .2s; }
</style>
}
