@model RestaurantOrdering.ViewModels.Admin.KitchenPerformanceReportVm
@{
    ViewData["Title"] = "Hiệu suất bếp";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-fire me-2 text-danger"></i>Hiệu suất bếp</h4>
</div>

<!-- Bộ lọc -->
<form method="get" class="card card-body mb-4 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-3">
            <label class="form-label small fw-semibold">Từ ngày</label>
            <input type="date" name="fromDate" value="@Model.Filter.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-3">
            <label class="form-label small fw-semibold">Đến ngày</label>
            <input type="date" name="toDate" value="@Model.Filter.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Lọc</button>
        </div>
    </div>
</form>

<!-- Thẻ số liệu -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value">@Model.AvgCookingMinutes.ToString("F1") phút</div>
            <div class="stat-label">TG chế biến TB</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value text-success">@Model.TotalServedItems</div>
            <div class="stat-label">Món đã phục vụ</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value text-warning">@Model.TotalCancelledItems</div>
            <div class="stat-label">Món đã hủy</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-value text-danger">@Model.TotalRejectedItems</div>
            <div class="stat-label">Bếp từ chối</div>
        </div>
    </div>
</div>

<!-- TG chế biến theo món -->
@if (!Model.ProductTimes.Any())
{
    <div class="empty-state py-5">
        <i class="bi bi-fire fs-1 text-muted"></i>
        <p class="mt-3 text-muted">Không có dữ liệu chế biến trong khoảng thời gian này.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header fw-semibold">Thời gian chế biến trung bình theo món</div>
        <div class="card-body">
            <div class="d-flex flex-column gap-2">
                @{
                    var maxMins = Model.ProductTimes.Any() ? Model.ProductTimes.Max(x => x.AvgMinutes) : 1;
                }
                @foreach (var (item, idx) in Model.ProductTimes.Select((x, i) => (x, i + 1)))
                {
                    var pct = maxMins > 0 ? (int)Math.Round(item.AvgMinutes / maxMins * 100) : 0;
                    var color = item.AvgMinutes > 20 ? "danger" : item.AvgMinutes > 10 ? "warning" : "success";
                    <div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="fw-semibold">@idx. @item.ProductName
                                <span class="text-muted fw-normal">(@item.ItemCount lần)</span>
                            </span>
                            <span class="text-muted">@item.AvgMinutes.ToString("F1") phút</span>
                        </div>
                        <div class="progress" style="height:16px; background:#f0f0f0">
                            <div class="progress-bar bg-@color" style="width:@Math.Max(pct, 2)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
