@model RestaurantOrdering.ViewModels.Admin.TopProductReportVm
@{
    ViewData["Title"] = "Món bán chạy";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Món bán chạy</h4>
</div>

<!-- Bộ lọc -->
<form method="get" class="card card-body mb-4 p-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-3">
            <label class="form-label small fw-semibold">Từ ngày</label>
            <input type="date" name="fromDate" value="@Model.Filter.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-3">
            <label class="form-label small fw-semibold">Đến ngày</label>
            <input type="date" name="toDate" value="@Model.Filter.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Lọc</button>
        </div>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="empty-state py-5">
        <i class="bi bi-bar-chart fs-1 text-muted"></i>
        <p class="mt-3 text-muted">Không có dữ liệu trong khoảng thời gian này.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var (item, idx) in Model.Items.Select((x, i) => (x, i + 1)))
                {
                    var pct = item.MaxQty > 0 ? (int)Math.Round((double)item.TotalQty / item.MaxQty * 100) : 0;
                    var barColor = idx <= 3 ? "primary" : idx <= 6 ? "info" : "secondary";
                    <div>
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <span class="fw-semibold">@idx. @item.ProductName
                                <small class="text-muted fw-normal ms-1">(@item.CategoryName)</small>
                            </span>
                            <span class="text-muted small">@item.TotalQty phần · @item.TotalRevenue.ToString("N0") ₫</span>
                        </div>
                        <div class="progress" style="height:20px; background:#f0f0f0">
                            <div class="progress-bar bg-@barColor" style="width:@pct%; font-size:0.75rem; line-height:20px">
                                @if (pct > 10) { <span>&nbsp;@item.TotalQty</span> }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Tên món</th>
                        <th>Danh mục</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (item, idx) in Model.Items.Select((x, i) => (x, i + 1)))
                    {
                        <tr>
                            <td class="text-muted">@idx</td>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-muted">@item.CategoryName</td>
                            <td class="text-center">@item.TotalQty</td>
                            <td class="text-end">@item.TotalRevenue.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
