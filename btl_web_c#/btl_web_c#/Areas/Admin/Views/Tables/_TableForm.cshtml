@model RestaurantOrdering.ViewModels.Admin.DiningTableViewModel
<form id="table-form" asp-area="Admin" asp-controller="Tables" asp-action="Save" method="post" onsubmit="return submitForm(this)">
    <div class="modal-header">
        <h5 class="modal-title fw-semibold">@(Model.Id==0?"Thêm bàn":"Sửa bàn")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id"/>
        <div class="mb-3">
            <label asp-for="Code" class="form-label fw-medium"></label>
            <input asp-for="Code" class="form-control" placeholder="VD: T01, A05" autofocus/>
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AreaId" class="form-label fw-medium"></label>
            <select asp-for="AreaId" asp-items="Model.Areas" class="form-select">
                <option value="">-- Chọn khu vực --</option>
            </select>
            <span asp-validation-for="AreaId" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label asp-for="Capacity" class="form-label fw-medium"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="50"/>
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>
            <div class="col-6 mb-3">
                <label asp-for="SortOrder" class="form-label fw-medium"></label>
                <input asp-for="SortOrder" class="form-control" type="number" min="0"/>
            </div>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    </div>
    <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button>
    </div>
</form>
