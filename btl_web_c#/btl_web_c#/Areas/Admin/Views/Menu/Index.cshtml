@using RestaurantOrdering.Models.Entities
@{
    ViewData["Title"] = "Món ăn";
    ViewData["Breadcrumb"] = "Món ăn";
    int page = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    var courseNames = new Dictionary<byte,string>{{1,"Khai vị"},{2,"Món chính"},{3,"Tráng miệng"}};
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Món ăn</h4>
    <button class="btn btn-primary" onclick="openForm(0)"><i class="bi bi-plus-lg me-1"></i>Thêm món</button>
</div>
<form method="get" class="mb-3 d-flex gap-2 flex-wrap">
    <input type="text" name="q" value="@ViewBag.Q" class="form-control" style="max-width:200px" placeholder="Tên/mã món..." />
    <select name="categoryId" class="form-select" style="max-width:180px">
        <option value="">-- Tất cả danh mục --</option>
        @foreach(var c in ViewBag.Categories as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>??[]) {
            if(c.Value == ViewBag.CategoryId?.ToString()) {
                <option value="@c.Value" selected>@c.Text</option>
            } else {
                <option value="@c.Value">@c.Text</option>
            }
        }
    </select>
    <select name="available" class="form-select" style="max-width:160px">
        <option value="">-- Tất cả --</option>
        @{ var av = ViewBag.Available; bool avTrue = av is bool bx && bx; bool avFalse = av is bool by && !by; }
        @if(avTrue){ <option value="true" selected>Còn hàng</option> } else { <option value="true">Còn hàng</option> }
        @if(avFalse){ <option value="false" selected>Hết hàng</option> } else { <option value="false">Hết hàng</option> }
    </select>
    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i></button>
    <a href="/Admin/Menu" class="btn btn-outline-secondary">Xóa lọc</a>
</form>
@if (Model is IEnumerable<Product> products && products.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Ảnh</th><th>Mã</th><th>Tên món</th><th>Danh mục</th><th>Nhóm ra</th><th class="text-end">Giá</th><th class="text-center">Còn hàng</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach(var p in products) {
                        <tr>
                            <td style="width:56px">
                                @if(!string.IsNullOrEmpty(p.ImageUrl)) {
                                    <img src="@p.ImageUrl" alt="@p.Name" class="rounded" style="width:48px;height:48px;object-fit:cover"/>
                                } else {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width:48px;height:48px">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td class="text-muted small">@p.Code</td>
                            <td class="fw-medium">@p.Name</td>
                            <td>@p.Category?.Name</td>
                            <td><span class="badge bg-secondary">@(courseNames.GetValueOrDefault(p.CourseGroup,"?"))</span></td>
                            <td class="text-end fw-semibold">@p.Price.ToString("N0") ₫</td>
                            <td class="text-center">
                                <button class="btn btn-sm @(p.IsAvailable?"btn-success":"btn-secondary")"
                                        onclick="toggleAvail(@p.Id,this)" title="@(p.IsAvailable?"Còn hàng – click để tắt":"Hết hàng – click để bật")">
                                    <i class="bi @(p.IsAvailable?"bi-check-lg":"bi-x-lg")"></i>
                                </button>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="openForm(@p.Id)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteItem(@p.Id,'@p.Name')"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">Tổng: @ViewBag.Total món</small>
        @if(totalPages>1){
            <nav><ul class="pagination pagination-sm mb-0">
                @for(int i=Math.Max(1,page-2);i<=Math.Min(totalPages,page+2);i++){
                    <li class="page-item @(i==page?"active":"")"><a class="page-link" href="?q=@ViewBag.Q&categoryId=@ViewBag.CategoryId&available=@ViewBag.Available&page=@i">@i</a></li>
                }
            </ul></nav>
        }
    </div>
}
else { <div class="empty-state"><i class="bi bi-journal-text fs-1 text-secondary"></i><h5 class="mt-3 text-secondary">Chưa có món nào</h5></div> }

<!-- Modal lớn hơn cho form món -->
<div class="modal fade" id="form-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="form-modal-content"></div>
    </div>
</div>
@section Scripts {
<script>
    const _af=document.querySelector('input[name="__RequestVerificationToken"]')?.value??'';
    function openForm(id){
        fetch(`/Admin/Menu/Form?id=${id}`,{headers:{'X-Requested-With':'XMLHttpRequest'}})
        .then(r=>r.text()).then(html=>{document.getElementById('form-modal-content').innerHTML=html;new bootstrap.Modal(document.getElementById('form-modal')).show();$.validator.unobtrusive.parse('#product-form');});
    }
    function submitForm(form){
        const fd=new FormData(form);
        fetch(form.action,{method:'POST',body:fd}).then(r=>r.json()).then(data=>{
            if(data.success){bootstrap.Modal.getInstance(document.getElementById('form-modal'))?.hide();showToast(data.message,'success');setTimeout(()=>location.reload(),800);}
            else{showToast(data.message||'Có lỗi xảy ra','danger');}
        });return false;
    }
    function toggleAvail(id,btn){
        const fd=new FormData();fd.append('id',id);fd.append('__RequestVerificationToken',_af);
        fetch('/Admin/Menu/ToggleAvailability',{method:'POST',body:fd}).then(r=>r.json()).then(data=>{
            if(data.success){
                btn.className=`btn btn-sm ${data.isAvailable?'btn-success':'btn-secondary'}`;
                btn.querySelector('i').className=`bi ${data.isAvailable?'bi-check-lg':'bi-x-lg'}`;
                showToast(data.isAvailable?'Đã bật còn hàng':'Đã tắt (hết hàng)','info');
            }
        });
    }
    function deleteItem(id,name){
        confirmAction(`Ẩn món "${name}"?`,()=>{
            const fd=new FormData();fd.append('id',id);fd.append('__RequestVerificationToken',_af);
            fetch('/Admin/Menu/Delete',{method:'POST',body:fd}).then(r=>r.json()).then(data=>{
                showToast(data.message,data.success?'success':'danger');if(data.success)setTimeout(()=>location.reload(),800);
            });
        });
    }
</script>
}
