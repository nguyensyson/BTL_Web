@model RestaurantOrdering.ViewModels.Admin.SettingsViewModel
@{
    ViewData["Title"] = "Cấu hình hệ thống";
    ViewData["Breadcrumb"] = "Cấu hình";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h4 class="fw-bold mb-4"><i class="bi bi-gear me-2 text-primary"></i>Cấu hình hệ thống</h4>

        <form asp-action="Index" method="post" novalidate>
            <!-- Thuế & Phí -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold bg-light">💰 Thuế & Phí dịch vụ</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="TaxRate" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <input asp-for="TaxRate" class="form-control" type="number" step="0.01" min="0" max="1"/>
                            <span class="input-group-text">(0–1)</span>
                        </div>
                        <small class="text-muted">Ví dụ: 0.08 = 8%</small>
                        <span asp-validation-for="TaxRate" class="text-danger small d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ServiceFeeRate" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <input asp-for="ServiceFeeRate" class="form-control" type="number" step="0.01" min="0" max="1"/>
                            <span class="input-group-text">(0–1)</span>
                        </div>
                        <small class="text-muted">Ví dụ: 0.05 = 5%</small>
                    </div>
                </div>
            </div>

            <!-- Bếp -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold bg-light">🍳 Bếp</div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="ItemSlaMinutes" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <input asp-for="ItemSlaMinutes" class="form-control" type="number" min="1" max="120"/>
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="ItemSlaMinutes" class="text-danger small d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReservationHoldMinutes" class="form-label fw-medium"></label>
                        <div class="input-group">
                            <input asp-for="ReservationHoldMinutes" class="form-control" type="number" min="5" max="120"/>
                            <span class="input-group-text">phút</span>
                        </div>
                        <span asp-validation-for="ReservationHoldMinutes" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>

            <!-- Nhà hàng -->
            <div class="card shadow-sm mb-4">
                <div class="card-header fw-semibold bg-light">🏠 Thông tin nhà hàng (in trên hóa đơn)</div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label asp-for="RestaurantName" class="form-label fw-medium"></label>
                        <input asp-for="RestaurantName" class="form-control"/>
                    </div>
                    <div class="col-12">
                        <label asp-for="RestaurantAddress" class="form-label fw-medium"></label>
                        <input asp-for="RestaurantAddress" class="form-control"/>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RestaurantPhone" class="form-label fw-medium"></label>
                        <input asp-for="RestaurantPhone" class="form-control"/>
                    </div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-floppy me-1"></i>Lưu cấu hình
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
