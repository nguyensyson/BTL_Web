@{
    ViewData["Title"] = "Danh mục món ăn";
    ViewData["Breadcrumb"] = "Danh mục";
    var totalPages = (int)ViewBag.TotalPages;
    var page = (int)ViewBag.Page;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-tags me-2 text-primary"></i>Danh mục</h4>
    <button class="btn btn-primary" onclick="openForm(0)">
        <i class="bi bi-plus-lg me-1"></i>Thêm danh mục
    </button>
</div>

<!-- Tìm kiếm -->
<form method="get" class="mb-3">
    <div class="input-group" style="max-width:380px">
        <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm tên danh mục..." />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(ViewBag.Q as string))
        {
            <a href="/Admin/Categories" class="btn btn-outline-danger"><i class="bi bi-x"></i></a>
        }
    </div>
</form>

<!-- Bảng -->
@if (Model is IEnumerable<dynamic> items && items.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th class="text-center">Thứ tự</th>
                        <th class="text-center">Số món</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = (page - 1) * 10; }
                    @foreach (var item in items)
                    {
                        idx++;
                        <tr>
                            <td class="text-muted small">@idx</td>
                            <td class="fw-medium">@item.Name</td>
                            <td class="text-muted small">@(item.Description ?? "—")</td>
                            <td class="text-center">@item.SortOrder</td>
                            <td class="text-center"><span class="badge bg-secondary">@item.ProductCount</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="openForm(@item.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteItem(@item.Id, '@item.Name')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- Phân trang -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <small class="text-muted">Tổng: @ViewBag.Total mục</small>
        @if (totalPages > 1)
        {
            <nav><ul class="pagination pagination-sm mb-0">
                @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="?q=@ViewBag.Q&page=@i">@i</a>
                    </li>
                }
            </ul></nav>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-tags fs-1 text-secondary"></i>
        <h5 class="mt-3 text-secondary">Chưa có danh mục nào</h5>
    </div>
}

<!-- Modal Form -->
<div class="modal fade" id="form-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="form-modal-content"></div>
    </div>
</div>

@section Scripts {
<script>
    const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    function openForm(id) {
        fetch(`/Admin/Categories/Form?id=${id}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.text())
        .then(html => {
            document.getElementById('form-modal-content').innerHTML = html;
            new bootstrap.Modal(document.getElementById('form-modal')).show();
            // Re-bind jquery validation
            $.validator.unobtrusive.parse('#category-form');
        });
    }

    function submitForm(form) {
        const fd = new FormData(form);
        fetch(form.action, { method: 'POST', body: fd })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('form-modal'))?.hide();
                showToast(data.message, 'success');
                setTimeout(() => location.reload(), 800);
            } else {
                // Partial view lỗi
                fetch(`/Admin/Categories/Form?id=${fd.get('Id')}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => r.text()).then(html => {
                        document.getElementById('form-modal-content').innerHTML = html;
                        $.validator.unobtrusive.parse('#category-form');
                    });
            }
        });
        return false;
    }

    function deleteItem(id, name) {
        confirmAction(`Xóa danh mục "${name}"?`, () => {
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', antiForgery);
            fetch('/Admin/Categories/Delete', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                showToast(data.message, data.success ? 'success' : 'danger');
                if (data.success) setTimeout(() => location.reload(), 800);
            });
        });
    }
</script>
}
