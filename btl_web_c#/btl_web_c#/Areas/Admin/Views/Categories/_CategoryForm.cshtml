@model RestaurantOrdering.ViewModels.Admin.CategoryViewModel
<form id="category-form" asp-area="Admin" asp-controller="Categories" asp-action="Save"
      method="post" onsubmit="return submitForm(this)">
    <div class="modal-header">
        <h5 class="modal-title fw-semibold">@(Model.Id == 0 ? "Thêm danh mục" : "Sửa danh mục")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-medium"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-medium"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SortOrder" class="form-label fw-medium"></label>
            <input asp-for="SortOrder" class="form-control" type="number" min="0" max="999" />
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    </div>
    <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Lưu
        </button>
    </div>
</form>
