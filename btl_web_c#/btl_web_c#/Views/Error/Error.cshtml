@{
    var code = (int)(ViewData["ErrorCode"] ?? 500);
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    var (icon, title, desc) = code switch {
        403 => ("bi-shield-exclamation", "Không có quyền truy cập",
                "Bạn không có quyền xem trang này. Vui lòng liên hệ quản trị viên nếu cần hỗ trợ."),
        404 => ("bi-compass",            "Trang không tìm thấy",
                "Trang bạn đang tìm kiếm không tồn tại hoặc đã bị xóa."),
        _   => ("bi-exclamation-triangle","Có lỗi xảy ra",
                "Hệ thống gặp sự cố. Vui lòng thử lại sau.")
    };

    ViewData["Title"] = $"Lỗi {code}";
}

<div class="auth-card text-center" style="max-width:480px">
    <div class="mb-3" style="font-size:4rem;color:var(--primary)">
        <i class="bi @icon"></i>
    </div>
    <h1 class="display-4 fw-bold text-secondary mb-1">@code</h1>
    <h2 class="h5 fw-semibold mb-3">@title</h2>
    <p class="text-muted mb-4">@desc</p>
    <div class="d-flex gap-2 justify-content-center">
        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Về trang chủ
        </a>
        <button onclick="history.back()" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </button>
    </div>
</div>
