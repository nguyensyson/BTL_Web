@* Trạng thái rỗng dùng chung. Model: (string Icon, string Title, string? Subtitle) *@
@model (string Icon, string Title, string? Subtitle)

<div class="empty-state">
    <i class="bi @Model.Icon fs-1 text-secondary"></i>
    <h5 class="mt-3 text-secondary">@Model.Title</h5>
    @if (!string.IsNullOrEmpty(Model.Subtitle))
    {
        <p class="text-muted small">@Model.Subtitle</p>
    }
</div>
