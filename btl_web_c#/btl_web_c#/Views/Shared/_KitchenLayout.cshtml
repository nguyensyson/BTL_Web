<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Bếp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="kds-body">
    @await Html.PartialAsync("_ConnectionBanner")

    <!-- KDS Topbar -->
    <header class="kds-topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand"><i class="bi bi-fire me-2"></i>Bếp</span>
            <span class="badge bg-warning text-dark" id="kds-pending-count">0 chờ làm</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span id="kds-clock" class="text-secondary small font-monospace"></span>
            <div id="kds-connection-dot" title="Kết nối"
                 style="width:10px;height:10px;border-radius:50%;background:#2ECC71;display:inline-block"></div>
            <button class="btn btn-sm btn-outline-secondary" id="kds-sound-toggle" title="Bật/tắt âm thanh">
                <i class="bi bi-volume-up" id="kds-sound-icon"></i>
            </button>
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Content -->
    <main class="kds-content">
        @* Hidden antiforgery token dùng cho AJAX *@
        @Html.AntiForgeryToken()
        @RenderBody()
    </main>

    @await Html.PartialAsync("_ToastContainer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Đồng hồ KDS
        function updateClock() {
            const now = new Date();
            const s = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const el = document.getElementById('kds-clock');
            if (el) el.textContent = s;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Âm thanh toggle
        let kdsSound = true;
        document.getElementById('kds-sound-toggle')?.addEventListener('click', function () {
            kdsSound = !kdsSound;
            const icon = document.getElementById('kds-sound-icon');
            if (icon) icon.className = kdsSound ? 'bi bi-volume-up' : 'bi bi-volume-mute';
        });
        window.playKdsSound = function () {
            if (!kdsSound) return;
            try {
                const ctx = new AudioContext();
                const osc = ctx.createOscillator();
                osc.connect(ctx.destination);
                osc.frequency.value = 880;
                osc.start(); osc.stop(ctx.currentTime + 0.15);
            } catch (_) {}
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
