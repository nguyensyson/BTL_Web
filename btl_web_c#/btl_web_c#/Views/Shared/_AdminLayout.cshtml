<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Quản trị</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="admin-wrapper">
    <!-- Sidebar -->
    <nav class="admin-sidebar" id="admin-sidebar">
        <a class="sidebar-brand" href="/Admin/Dashboard">
            <i class="bi bi-cup-hot-fill me-2"></i>Nhà Hàng <span>Admin</span>
        </a>
        <ul class="nav flex-column mt-2 flex-grow-1">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/Admin/Dashboard">
                    <i class="bi bi-speedometer2"></i> Tổng quan
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")"
                   href="/Admin/Menu">
                    <i class="bi bi-journal-text"></i> Món ăn
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                   href="/Admin/Categories">
                    <i class="bi bi-tags"></i> Danh mục
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Areas" ? "active" : "")"
                   href="/Admin/Areas">
                    <i class="bi bi-geo-alt"></i> Khu vực
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tables" ? "active" : "")"
                   href="/Admin/Tables">
                    <i class="bi bi-grid-3x3-gap"></i> Bàn ăn
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" ? "active" : "")"
                   href="/Admin/Staff">
                    <i class="bi bi-people"></i> Nhân viên
                </a>
            </li>
            <li><hr class="border-secondary my-2 mx-3" /></li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bills" ? "active" : "")"
                   href="/Admin/Bills">
                    <i class="bi bi-receipt"></i> Lịch sử bill
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                   href="/Admin/Reports">
                    <i class="bi bi-bar-chart-line"></i> Báo cáo
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")"
                   href="/Admin/AuditLogs">
                    <i class="bi bi-shield-check"></i> Nhật ký
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"
                   href="/Admin/Settings">
                    <i class="bi bi-gear"></i> Cấu hình
                </a>
            </li>
        </ul>
        <div class="px-3 pb-3 mt-auto">
            <small class="text-secondary">@User.Identity?.Name</small>
        </div>
    </nav>

    <!-- Main -->
    <div class="admin-main">
        <!-- Topbar -->
        <header class="admin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary d-md-none" id="sidebar-toggle" aria-label="Menu">
                    <i class="bi bi-list fs-5"></i>
                </button>
                @if (ViewData["Breadcrumb"] is string bc)
                {
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none">Trang chủ</a></li>
                            <li class="breadcrumb-item active">@bc</li>
                        </ol>
                    </nav>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small d-none d-md-inline">
                    <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="d-none d-md-inline ms-1">Đăng xuất</span>
                    </button>
                </form>
            </div>
        </header>

        <!-- Content -->
        <main class="admin-content">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible alert-auto-dismiss fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

@await Html.PartialAsync("_ConfirmModal")
@await Html.PartialAsync("_ToastContainer")

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
