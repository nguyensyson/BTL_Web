# =====================================================================
# .gitignore – Hệ thống đặt món (ASP.NET Core / C# / SQL Server)
# =====================================================================

# ── Tài liệu nội bộ (chỉ giữ ở máy local) ───────────────────────────
doc/
.kiro/
CLAUDE.md

# ── Build outputs ────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# ── Visual Studio / VS Code ──────────────────────────────────────────
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.vcxproj.filters

# ── .NET / NuGet ─────────────────────────────────────────────────────
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
packages/
!**/[Pp]ackages/build/

# ── ASP.NET Core / Entity Framework ──────────────────────────────────
# Secret cấu hình – KHÔNG được commit
**/appsettings.Development.json
**/appsettings.Local.json
**/secrets.json

# ── User Secrets (dotnet user-secrets) ───────────────────────────────
# Windows: %APPDATA%\Microsoft\UserSecrets – không nằm trong repo
# nhắc nhở: dùng `dotnet user-secrets set` thay vì hardcode

# ── Tệp môi trường ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Upload ảnh (nếu lưu local, không muốn push lên) ──────────────────
**/wwwroot/uploads/

# ── Serilog logs ─────────────────────────────────────────────────────
**/Logs/
*.log

# ── Publish output ───────────────────────────────────────────────────
publish/
**/Properties/PublishProfiles/

# ── Docker ───────────────────────────────────────────────────────────
# Giữ Dockerfile & docker-compose.yml; bỏ dữ liệu volume local
docker-data/
.dockerignore.local

# ── macOS / Windows ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Rider / JetBrains ────────────────────────────────────────────────
.idea/
*.sln.iml

# ── Test results ─────────────────────────────────────────────────────
TestResults/
*.trx
*.coverage
*.coveragexml

# ── Kiro IDE ─────────────────────────────────────────────────────────
# Giữ .kiro/steering và .kiro/hooks để chia sẻ config nhóm,
# bỏ cache/session cá nhân
.kiro/cache/
.kiro/sessions/
